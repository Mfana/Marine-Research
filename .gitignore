# Environment
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/

# Credentials — never commit
.env
*.netrc
.copernicusmarine/
.copernicusmarine-credentials
copernicusmarine-credentials

# Data and large outputs (regenerate from remote source)
data/cache/*
data/processed/*
data/samples/*
outputs/models/*
!**/.gitkeep
*.nc
*.zarr/

logs/*.log
.DS_Store

# Figures are regenerated by the notebooks and embedded in them; keep history small
outputs/figures/*

# LaTeX build files (PDFs of the manuscripts are kept)
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.spl
*.synctex.gz
papers/**/build.log
data/cache/_daily_checkpoints/

# Manuscripts are kept private: papers/ is a separate local repository, not published
papers/

# Findings stay private until the papers are published
COMPLETION_REPORT.md
outputs/tables/*
!outputs/tables/.gitkeep
